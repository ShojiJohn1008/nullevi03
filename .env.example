# このファイルを .env にコピーして実際の値を書く:
#   cp .env.example .env
# .env は .gitignore 済みなのでコミットされない。
#
# briefing.sh (と launchd/cron 経由の実行) がここから設定値を読み込む。

# BotFather で発行した Bot トークン
TELEGRAM_BOT_TOKEN=00000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 送信先チャット ID (getUpdates で調べた数字)
TELEGRAM_CHAT_ID=000000000

# 天気を調べる地域 (任意。省略時は Tokyo)
BRIEFING_LOCATION=Tokyo

# --- メール要約 (mail_summary.sh) 用。使わないなら空のままでよい ---

# Gmail アドレス
GMAIL_ADDRESS=you@gmail.com

# Gmail のアプリパスワード。2段階認証を ON にして発行する。
# Google は "abcd efgh ijkl mnop" のように空白区切りで表示するが、
# .env では空白を必ず詰めて 16 文字続けて書くこと (例 abcdefghijklmnop)。
# ※ 空白を残すと .env の読み込みが壊れる (値の途中がコマンド扱いになる)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 要約対象の送信者アドレス。カンマ区切りで複数指定できる (スペースを入れない)
MAIL_SENDERS=boss@example.com,info@example.com

# 何日前まで遡って探すか (任意。省略時は 3)
MAIL_LOOKBACK_DAYS=3

# --- 複数の受信箱を横断したい場合 (任意) ---
# 上の GMAIL_ADDRESS / GMAIL_APP_PASSWORD は「受信箱が1つ」の簡易指定。
# 2つ以上の受信箱から集めたいときは、代わりに下の番号付きで並べる。
# (MAIL_ACCOUNT_1_* を1つでも書くと、上の GMAIL_* は無視される)
#
# 1つ目の受信箱 (例: Gmail)
#MAIL_ACCOUNT_1_ADDRESS=you@gmail.com
#MAIL_ACCOUNT_1_PASSWORD=abcdefghijklmnop
#MAIL_ACCOUNT_1_HOST=imap.gmail.com
#
# 2つ目の受信箱 (例: 独自ドメイン。HOST は各社の IMAP サーバー名)
#MAIL_ACCOUNT_2_ADDRESS=you@example2.com
#MAIL_ACCOUNT_2_PASSWORD=xxxxxxxxxxxx
#MAIL_ACCOUNT_2_HOST=imap.example2.com
#
# 3つ目以降は _3_, _4_ と番号を増やす。HOST 省略時は imap.gmail.com。
# 送信者の絞り込み (MAIL_SENDERS) は全アカウント共通で適用される。

# --- カレンダー連携 (gcal.py / 日程調整) 用。使わないなら空でよい ---
# Apps Script ウェブアプリの設置は gas/README.md を参照。
# 公開した /exec の URL
CAL_WEBAPP_URL=https://script.google.com/macros/s/xxxxx/exec
# Apps Script のスクリプトプロパティ SHARED_SECRET と同じ合言葉
CAL_SHARED_SECRET=ここに自分で決めた長めの合言葉
