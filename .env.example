# このファイルを .env にコピーして実際の値を書く:
#   cp .env.example .env
# .env は .gitignore 済みなのでコミットされない。
#
# briefing.sh (と launchd/cron 経由の実行) がここから設定値を読み込む。

# BotFather で発行した Bot トークン
TELEGRAM_BOT_TOKEN=00000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 送信先チャット ID (getUpdates で調べた数字)
TELEGRAM_CHAT_ID=000000000

# 天気を調べる地域 (任意。省略時は Tokyo)
BRIEFING_LOCATION=Tokyo

# --- メール要約 (mail_summary.sh) 用。使わないなら空のままでよい ---

# Gmail アドレス
GMAIL_ADDRESS=you@gmail.com

# Gmail のアプリパスワード。2段階認証を ON にして発行する。
# Google は "abcd efgh ijkl mnop" のように空白区切りで表示するが、
# .env では空白を必ず詰めて 16 文字続けて書くこと (例 abcdefghijklmnop)。
# ※ 空白を残すと .env の読み込みが壊れる (値の途中がコマンド扱いになる)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# 要約対象の送信者アドレス。カンマ区切りで複数指定できる
MAIL_SENDERS=boss@example.com,info@example.com

# 何日前まで遡って探すか (任意。省略時は 3)
MAIL_LOOKBACK_DAYS=3
